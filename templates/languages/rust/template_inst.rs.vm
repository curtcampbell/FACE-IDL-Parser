## template_inst.rs.vm
## Generates Rust items for a FACE template module instantiation.
##
## Each substituted definition is emitted as a top-level item directly into
## this module file — module identity comes from the file's own location in
## the generated tree (see mod.rs.vm); there is no C#-style `namespace { }`
## wrapper to open here.
##
## Mapping for each definition inside the instantiation:
##   InterfaceNode (single op, named "Set_Reference") -> pub trait Injectable:
##     Send { fn set_reference(...) -> (...); } -- the FACE dependency-
##     injection port pattern; see interface.rs.vm's module doc for the full
##     rationale (this mirrors it exactly, since a TypedTS_Injectable's
##     "Injectable" interface reaches this branch, not interface.rs.vm's,
##     when it's substituted from a template instantiation).
##   InterfaceNode (single op, otherwise) -> boxed FnMut type alias
##   InterfaceNode (multi op)  -> pub trait
##   StructNode                -> pub struct (Debug/Clone/PartialEq — see
##                                struct.rs.vm for why Default is not derived)
##   EnumNode                  -> pub enum (Debug/Clone/Copy/PartialEq/Eq/Default)
##
## Context:
##   $alias       — String: local alias name (e.g. "Read_Callback")
##   $definitions — List<IdlDefinition>: substituted definitions
##   $types       — TypeResolver
##
## Generated by Entity Reactor IDL Generator.
#![allow(non_snake_case, non_camel_case_types)]
##
## $localSiblingNames — read by macros.vm's rustScopedType: a bare reference
## to one of THIS file's own substituted definitions (e.g. a TypedTS operation
## parameter typed as the sibling Read_Callback interface) is an in-file item
## reference, not a separate module -- see the comment on rustScopedType.
#set($localSiblingNames = [])
#foreach($__d in $definitions)
#set($__x = $localSiblingNames.add($__d.name))
#end
#foreach($def in $definitions)
#set($defType = $def.class.simpleName)
#if($defType == "InterfaceNode")
#if($def.operations.size() == 1)
#set($op = $def.operations.get(0))
#if($op.name == "Set_Reference")
## ── FACE dependency-injection port -> trait, not boxed closure ─────────────
/// Injectable port for substituted IDL interface `${def.name}`
/// (template instantiation `${alias}`).
///
/// IDL: `${def.name}::${op.name}(#idlParamSummary($op))`
pub trait $types.safeName($def.name): Send {
    fn set_reference(#selfAndParams($op)) -> #rustLogicalReturn($op);
}

#else
## ── Ordinary single-operation interface -> boxed closure type alias ────────
/// Boxed callback for substituted IDL interface `${def.name}`
/// (template instantiation `${alias}`).
///
/// IDL: `${def.name}::${op.name}(#idlParamSummary($op))`
pub type $types.safeName($def.name) = Box<dyn FnMut(#paramTypesOnly($op)) -> #rustReturnType($op) + Send>;

#end
#else
## ── trait ────────────────────────────────────────────────────────────────────
/// Rust trait for substituted IDL interface `${def.name}`
/// (template instantiation `${alias}`).
pub trait $types.safeName($def.name)#if(!$def.inheritedInterfaces.isEmpty()): #foreach($base in $def.inheritedInterfaces)${base}#if(!$foreach.last) + #end#end#end {
#foreach($op in $def.operations)
    /// IDL: `#idlParamSummary($op)`
    fn $types.safeName($op.name)(#selfAndParams($op)) -> #rustReturnType($op);

#end
}

#end
#elseif($defType == "StructNode")
## ── struct ───────────────────────────────────────────────────────────────────
/// Rust struct for substituted IDL struct `${def.name}`
/// (template instantiation `${alias}`).
#[derive(Debug, Clone, PartialEq)]
pub struct $types.safeName($def.name) {
#foreach($member in $def.members)
    /// IDL member `${member.name}`.
    pub $types.safeName($member.name): #rustType($member.type),
#end
}

#elseif($defType == "EnumNode")
## ── enum ─────────────────────────────────────────────────────────────────────
/// Rust enum for substituted IDL enum `${def.name}`
/// (template instantiation `${alias}`).
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub enum $types.safeName($def.name) {
#foreach($val in $def.values)
#if($foreach.first)
    #[default]
    ${val.name},
#else
    ${val.name},
#end
#end
}

#end
#end
