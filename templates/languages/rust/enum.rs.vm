## enum.rs.vm
## Generates a Rust enum for an IDL enum.
##
## Mapping (no FACE standard — pragmatic):
##   IDL enum -> C-like Rust enum, IDL value names preserved verbatim.
##   The first declared value is marked #[default] so #[derive(Default)]
##   works both here and on any struct that embeds this enum as a field.
##
## Context:
##   $enumNode — EnumNode
##   $types    — TypeResolver
##
## Generated by Entity Reactor IDL Generator.
#![allow(non_snake_case, non_camel_case_types)]
##
/// Rust enum for IDL enum `${enumNode.name}`.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub enum $types.safeName($enumNode.name) {
#foreach($val in $enumNode.values)
#if($foreach.first)
    #[default]
    ${val.name},
#else
    ${val.name},
#end
#end
}
