## enum.cs.vm
## Generates a C# enum for an IDL enum.
##
## Mapping (no FACE standard — pragmatic):
##   IDL enum → C# enum with IDL value names preserved.
##   No explicit underlying type; C# defaults to int which is sufficient
##   for all FACE-defined enums.
##
## Context:
##   $enumNode      — EnumNode
##   $namespaceName — String  (e.g. "FACE.DM.SampleModel")
##   $cs            — CsharpTypeHelper
##
## Generated by Entity Reactor IDL Generator.
#if(!$namespaceName.isEmpty())
namespace ${namespaceName}
{
#end
    /// <summary>C# enum for IDL enum <c>${enumNode.name}</c>.</summary>
    public enum ${enumNode.name}
    {
#foreach($val in $enumNode.values)
#if($foreach.last)
        ${val.name}
#else
        ${val.name},
#end
#end
    }
#if(!$namespaceName.isEmpty())
}
#end
