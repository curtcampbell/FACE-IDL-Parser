## interface.cs.vm
## Generates a C# delegate or interface for an IDL interface.
##
## Mapping rules:
##   Single-operation IDL interface → C# delegate (callback pattern).
##     The delegate name is the IDL interface name (no I-prefix).
##     The delegate signature is derived from csharpReturnType / inputParamList.
##
##   Multi-operation IDL interface → C# interface (I-prefixed name).
##     IDL 'out' param  → moved to C# return value
##     IDL 'inout' param → appears in both inputParamList (as regular param)
##                          and the return tuple
##     Multiple out/inout → C# named tuple (T1 Name1, T2 Name2, ...)
##     'in' params       → regular C# parameters
##
##   No Holder<T>, no 'out' or 'ref' keywords; these are not interop boundaries.
##
## Context:
##   $iface         — InterfaceNode
##   $namespaceName — String  (e.g. "FACE.DM.SampleModel")
##   $types         — TypeResolver
##
## Generated by Entity Reactor IDL Generator.
#if($iface.operations.size() == 1)
## ── Single-operation interface → delegate ──────────────────────────────────
#set($op = $iface.operations.get(0))
#if(!$namespaceName.isEmpty())
namespace ${namespaceName}
{
#end
    /// <summary>
    /// C# delegate for IDL callback interface <c>${iface.name}</c>.
    /// </summary>
    /// <remarks>
    /// IDL: <code>${iface.name}::${op.name}(#idlParamSummary($op))</code>
    /// </remarks>
    public delegate #csharpReturnType($op) ${iface.name}(#inputParamList($op));
#if(!$namespaceName.isEmpty())
}
#end
#else
## ── Multi-operation interface → C# interface ───────────────────────────────
#if(!$namespaceName.isEmpty())
namespace ${namespaceName}
{
#end
    /// <summary>
    /// C# interface for IDL interface <c>${iface.name}</c>.
    /// </summary>
    public interface I${iface.name}#if(!$iface.inheritedInterfaces.isEmpty()) : #foreach($base in $iface.inheritedInterfaces)I${base}#if(!$foreach.last), #end#end#end

    {
#foreach($op in $iface.operations)
        /// <summary>
        /// IDL: <code>#idlParamSummary($op)</code>
        /// </summary>
        /// <exception cref="FACE.BadParamException">Thrown when an invalid parameter is supplied.</exception>
        /// <exception cref="FACE.DataConversionException">Thrown on a data-conversion failure.</exception>
        #csharpReturnType($op) $types.toPascalCase($op.name)(#inputParamList($op));

#end
    }
#if(!$namespaceName.isEmpty())
}
#end
#end
