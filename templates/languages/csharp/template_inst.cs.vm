## template_inst.cs.vm
## Generates C# types for a FACE template module instantiation.
##
## Unlike the Java mapping (which wraps everything in a static outer class),
## each substituted definition is emitted directly into the namespace.
## This follows idiomatic C# convention: one logical type per file, in its
## own namespace.
##
## Mapping for each definition inside the instantiation:
##   InterfaceNode (single op)  → delegate
##   InterfaceNode (multi op)   → I-prefixed interface
##   StructNode                 → sealed class with copy ctor
##   EnumNode                   → C# enum
##
## Context:
##   $alias         — String: local alias name (e.g. "Read_Callback")
##   $namespaceName — String  (e.g. "FACE.TSS.EntityEvent")
##   $definitions   — List<IdlDefinition>: substituted definitions
##   $types         — TypeResolver
##
## Generated by Entity Reactor IDL Generator.
#if(!$namespaceName.isEmpty())
namespace ${namespaceName}
{
#end
#foreach($def in $definitions)
#set($defType = $def.class.simpleName)
#if($defType == "InterfaceNode")
#if($def.operations.size() == 1)
## ── delegate ───────────────────────────────────────────────────────────────
#set($op = $def.operations.get(0))
    /// <summary>
    /// C# delegate for substituted IDL callback interface <c>${def.name}</c>
    /// (template instantiation <c>${alias}</c>).
    /// </summary>
    /// <remarks>IDL: <code>${def.name}::${op.name}(#idlParamSummary($op))</code></remarks>
    public delegate #csharpReturnType($op) ${def.name}(#inputParamList($op));

#else
## ── interface ──────────────────────────────────────────────────────────────
    /// <summary>
    /// C# interface for substituted IDL interface <c>${def.name}</c>
    /// (template instantiation <c>${alias}</c>).
    /// </summary>
    public interface I${def.name}#if(!$def.inheritedInterfaces.isEmpty()) : #foreach($base in $def.inheritedInterfaces)I${base}#if(!$foreach.last), #end#end#end

    {
#foreach($op in $def.operations)
        /// <summary>IDL: <code>#idlParamSummary($op)</code></summary>
        /// <exception cref="FACE.BadParamException">Invalid parameter.</exception>
        /// <exception cref="FACE.DataConversionException">Data-conversion failure.</exception>
        #csharpReturnType($op) $types.toPascalCase($op.name)(#inputParamList($op));

#end
    }

#end
#elseif($defType == "StructNode")
## ── sealed class ───────────────────────────────────────────────────────────
    /// <summary>
    /// C# class for substituted IDL struct <c>${def.name}</c>
    /// (template instantiation <c>${alias}</c>).
    /// </summary>
    /// <remarks>
    /// <b>Copy semantics:</b> reference type — use <c>new ${def.name}(source)</c>
    /// at every UoP exchange boundary.
    /// </remarks>
    public sealed class ${def.name}
    {
#foreach($member in $def.members)
        /// <summary>IDL member <c>${member.name}</c>.</summary>
        public $types.type($member.type) $types.toPascalCase($member.name) { get; set; }

#end
        /// <summary>Default constructor.</summary>
        public ${def.name}() { }

        /// <summary>Deep copy constructor.</summary>
        public ${def.name}(${def.name} source)
        {
            if (source is null) throw new System.ArgumentNullException(nameof(source));
#foreach($member in $def.members)
            $types.toPascalCase($member.name) = #copyExpr($member.type $types.toPascalCase($member.name));
#end
        }
    }

#elseif($defType == "EnumNode")
## ── enum ───────────────────────────────────────────────────────────────────
    /// <summary>
    /// C# enum for substituted IDL enum <c>${def.name}</c>
    /// (template instantiation <c>${alias}</c>).
    /// </summary>
    public enum ${def.name}
    {
#foreach($val in $def.values)
#if($foreach.last)
        ${val.name}
#else
        ${val.name},
#end
#end
    }

#end
#end
#if(!$namespaceName.isEmpty())
}
#end
