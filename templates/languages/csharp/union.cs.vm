## union.cs.vm
## Generates one C# class for an IDL union declaration.
## C# has no normative FACE TS mapping for unions; this uses a sealed class
## with a discriminant property and per-branch typed accessors.
##
## Context:
##   $union         — UnionNode
##   $moduleStack   — List<String>
##   $namespaceName — String (dot-separated namespace, computed by engine)
##   $types         — TypeResolver
##
namespace ${namespaceName}
{
    /// <summary>
    /// IDL union <c>${union.name}</c> — generated by Entity Reactor IDL Generator.
    /// Discriminant type: <c>$types.type($union.switchType)</c>.
    /// </summary>
    public sealed class ${union.name}
    {
        private $types.type($union.switchType) _disc;

#foreach($case in $union.cases)
        private $types.type($case.type) _${case.name};
#end

        /// <summary>Gets the active discriminant value.</summary>
        public $types.type($union.switchType) Discriminant => _disc;

#foreach($case in $union.cases)
        // Case: #if($case.default)default#{else}$case.labels#end
        public void Set$types.toPascalCase($case.name)($types.type($case.type) v)
        {
#if(!$case.default)
            _disc = $case.labels.get(0);
#end
            _${case.name} = v;
        }

        public $types.type($case.type) Get$types.toPascalCase($case.name)() => _${case.name};

#end
    }
}
