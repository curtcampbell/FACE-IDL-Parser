## const.cs.vm
## Generates one C# class for an IDL const declaration.
## Emitted as a static class with a single public const field.
##
## Context:
##   $constNode     — ConstNode
##   $moduleStack   — List<String>
##   $namespaceName — String (dot-separated namespace, computed by engine)
##   $types         — TypeResolver
##
namespace ${namespaceName}
{
    /// <summary>
    /// IDL const <c>${constNode.name}</c> — generated by Entity Reactor IDL Generator.
    /// </summary>
    public static class ${constNode.name}
    {
        /// <summary>IDL const value: <c>${constNode.value}</c>.</summary>
        public const $types.type($constNode.type) Value = ${constNode.value};
    }
}
