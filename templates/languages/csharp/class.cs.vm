## class.cs.vm
## Generates a C# sealed class for an IDL struct.
##
## Mapping:
##   IDL struct → C# sealed class with auto-properties, default constructor,
##   and deep copy constructor.
##
## COPY SEMANTICS WARNING — classes are reference types.  If you pass an
## instance of this type across a UoP boundary without copying it, both sides
## share the same object; a later mutation on either side silently affects the
## other.  The TSS implementation must call the copy constructor at every
## send/receive boundary.  UoP client code must do the same when it retains
## a reference beyond the immediate call.
##
## Context:
##   $struct        — StructNode
##   $namespaceName — String  (e.g. "FACE.DM.SampleModel", computed by engine)
##   $types         — TypeResolver
##
## Generated by Entity Reactor IDL Generator.
#if(!$namespaceName.isEmpty())
namespace ${namespaceName}
{
#end
    /// <summary>
    /// C# class for IDL struct <c>${struct.name}</c>.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <b>Copy semantics:</b> this is a reference type (<c>class</c>).  Always
    /// use the copy constructor — <c>new ${struct.name}(source)</c> — when
    /// storing or forwarding an instance beyond its original scope.  The TSS
    /// performs a deep copy at every data-exchange boundary; UoP client code
    /// is responsible for doing the same when retaining a reference.
    /// </para>
    /// </remarks>
    public sealed class ${struct.name}
    {
#foreach($member in $struct.members)
        /// <summary>IDL member <c>${member.name}</c>.</summary>
        public $types.type($member.type) $types.toPascalCase($member.name) { get; set; }

#end
        /// <summary>Default constructor — all members initialised to their default values.</summary>
        public ${struct.name}() { }

        /// <summary>
        /// Deep copy constructor.  Use this to obtain an independent copy of
        /// <paramref name="source"/> before storing or forwarding the object.
        /// </summary>
        /// <param name="source">The instance to copy.  Must not be <c>null</c>.</param>
        public ${struct.name}(${struct.name} source)
        {
            if (source is null) throw new System.ArgumentNullException(nameof(source));
#foreach($member in $struct.members)
            $types.toPascalCase($member.name) = #copyExpr($member.type $types.toPascalCase($member.name));
#end
        }
    }
#if(!$namespaceName.isEmpty())
}
#end
