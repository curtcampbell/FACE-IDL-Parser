## const.java.vm
## Generates one Java interface for an IDL const declaration.
## FACE TS 3.2 §4.14.10 — const declared outside an IDL interface scope maps to
## a Java interface bearing the same name, with a single public static final
## field named 'value' per §4.14.10.6.
##
## Context:
##   $constNode   — ConstNode
##   $moduleStack — List<String>  (module path segments)
##   $packageName — String        (dot-separated package, computed by engine)
##   $types       — TypeResolver
##
package ${packageName};

/**
 * IDL const {@code ${constNode.name}} — generated by Entity Reactor IDL Generator.
 */
public interface ${constNode.name} {

    /** IDL const value: {@code ${constNode.value}}. */
    public static final $types.type($constNode.type) value = ${constNode.value};
}
