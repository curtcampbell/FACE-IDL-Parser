## union.java.vm
## Generates one Java interface for an IDL union declaration.
## FACE TS 3.2 §4.14.10 — union mapped to a Java interface with discriminant and
## per-branch typed getter/setter pairs per §4.14.10.8.2.
##
## Context:
##   $union       — UnionNode
##   $moduleStack — List<String>  (module path segments)
##   $packageName — String        (dot-separated package, computed by engine)
##   $types       — TypeResolver
##
package ${packageName};

/**
 * IDL union {@code ${union.name}} — generated by Entity Reactor IDL Generator.
 *
 * <p>Discriminant type: {@code $types.type($union.switchType)}.
 * Per FACE TS 3.2 §4.14.10, exactly one branch member is active at a time;
 * the active branch is determined by the discriminant value.
 */
public interface ${union.name} {

    // Discriminant accessor
    $types.type($union.switchType) getDiscriminator();

#foreach($case in $union.cases)
    // Case: #if($case.default)default#{else}$case.labels#end
    $types.type($case.type) #getterName($case.name)();
    void #setterName($case.name)($types.type($case.type) val);

#end
}
