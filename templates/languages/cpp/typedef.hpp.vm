## typedef.hpp.vm
## Generates one C++ header for an IDL typedef declaration.
## FACE TS 3.2 §4.14.8.5 — typedef mapped to a C++ typedef declaration.
##
## For bounded sequences an additional companion #define is emitted per
## FACE TS convention: <TypeName>_bound_value holds the FACE::UnsignedLong bound.
##
## Context:
##   $typedef    — TypedefNode
##   $namespaces — List<String>  (module path segments)
##   $types      — TypeResolver
##
#set($guard = "${types.guard($namespaces, $typedef.name)}_HPP")
#set($H = "#")
${H}pragma once
${H}ifndef ${guard}
${H}define ${guard}

\#include <FACE/Common.hpp>
#if($typedef.underlyingType.class.simpleName == "Sequence")
\#include <FACE/Sequence.hpp>
#end

#set($nsAction = "open")#parse("_namespaces.vm")

/// IDL typedef ${typedef.name} — generated by Entity Reactor IDL Generator.
typedef $types.type($typedef.underlyingType) ${typedef.name};
#if($typedef.underlyingType.class.simpleName == "Sequence" && $typedef.underlyingType.bound.isPresent())

${H}define ${typedef.name}_bound_value ((FACE::UnsignedLong) $typedef.underlyingType.bound.asInt)
#end

#set($nsAction = "close")#parse("_namespaces.vm")

${H}endif // ${guard}
