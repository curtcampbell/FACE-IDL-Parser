## interface.hpp.vm
## Generates one C++ header for an IDL interface — emitted as a pure-virtual
## abstract class per FACE TS 3.2 §4.14.8.10.1.
##
## Context:
##   $iface      — InterfaceNode
##   $namespaces — List<String>  (module path segments)
##   $types      — TypeResolver
##
#set($guard = "${types.guard($namespaces, $iface.name)}_HPP")
#set($H = "#")
${H}pragma once
${H}ifndef ${guard}
${H}define ${guard}

\#include <FACE/Common.hpp>

#set($nsAction = "open")#parse("_namespaces.vm")

/// IDL interface ${iface.name} — generated by Entity Reactor IDL Generator.
/// Pure-virtual abstract class per FACE TS 3.2 §4.14.8.10.1.
#if($iface.inheritedInterfaces.size() > 0)
class ${iface.name}
#set($sep = "    : public ")
#foreach($base in $iface.inheritedInterfaces)
${sep}${base}
#set($sep = "    , public ")
#end
{
#else
class ${iface.name} {
#end
public:
    virtual ~${iface.name}() {}

#foreach($op in $iface.operations)
#if($op.oneway)
    /// @note IDL oneway — fire-and-forget; no return value.
#end
#set($rt = $types.type($op.returnType))
#set($hasRetval = false)
#if(!$op.oneway && $rt != "void")
#set($hasRetval = true)
#end
    virtual void ${op.name}(
#foreach($param in $op.parameters)
#if($foreach.last && !$hasRetval)
        $types.paramDecl($param)) = 0;
#else
        $types.paramDecl($param),
#end
#end
#if($hasRetval)
        ${rt}& retval) = 0;
#elseif($op.parameters.isEmpty())
        ) = 0;
#end

#end
protected:
    ${iface.name}() {}
private:
    ${iface.name}(const ${iface.name}&);
    ${iface.name}& operator=(const ${iface.name}&);
};

#set($nsAction = "close")#parse("_namespaces.vm")

${H}endif // ${guard}
