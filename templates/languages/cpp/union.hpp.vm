## union.hpp.vm
## Generates one C++ header for an IDL union declaration.
## FACE TS 3.2 §4.14.8.5 — union mapped to a class with discriminant accessor
## and per-branch typed getter/setter pairs.
##
## Context:
##   $union      — UnionNode
##   $namespaces — List<String>  (module path segments)
##   $types      — TypeResolver
##
#set($guard = "${types.guard($namespaces, $union.name)}_HPP")
#set($H = "#")
${H}pragma once
${H}ifndef ${guard}
${H}define ${guard}

\#include <FACE/Common.hpp>

#set($nsAction = "open")#parse("_namespaces.vm")

/// IDL union ${union.name} — generated by Entity Reactor IDL Generator.
/// Discriminant type: $types.type($union.switchType)
class ${union.name} {
public:
    enum RETURN_CODE { NO_ERROR, INVALID_STATE };

    ${union.name}();
    ${union.name}(const ${union.name}&);
    ~${union.name}();
    ${union.name}& operator=(const ${union.name}&);

    // Discriminant accessor
    $types.type($union.switchType) discriminator() const;

#foreach($case in $union.cases)
    // Case: #if($case.default)default#{else}$case.labels#end
    void ${case.name}(const $types.type($case.type)&);
    void ${case.name}($types.type($case.type)&, RETURN_CODE&) const;
#end
};

#set($nsAction = "close")#parse("_namespaces.vm")

${H}endif // ${guard}
