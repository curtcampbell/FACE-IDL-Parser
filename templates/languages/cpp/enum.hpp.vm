## enum.hpp.vm
## Generates one C++ header for an IDL enum declaration.
##
## Context:
##   $enumNode   — EnumNode
##   $namespaces — List<String>  (module path segments)
##   $types      — TypeResolver
##
#set($guard = "${types.guard($namespaces, $enumNode.name)}_HPP")
#set($H = "#")
${H}pragma once
${H}ifndef ${guard}
${H}define ${guard}

#set($nsAction = "open")#parse("_namespaces.vm")

/// IDL enum ${enumNode.name} — generated by Entity Reactor IDL Generator.
struct ${enumNode.name} {
    enum Value {
#foreach($val in $enumNode.values)
#if($foreach.last)
        ${val.name}
#else
        ${val.name},
#end
#end
    };
private:
    ${enumNode.name}();
};

#set($nsAction = "close")#parse("_namespaces.vm")

${H}endif // ${guard}
