## const.hpp.vm
## Generates one C++ header for an IDL const declaration.
## FACE TS 3.2 §4.14.8.6 — const mapped to a #define with type cast.
##
## Context:
##   $constNode  — ConstNode
##   $namespaces — List<String>  (module path segments)
##   $types      — TypeResolver
##
#set($guard = "${types.guard($namespaces, $constNode.name)}_HPP")
#set($H = "#")
${H}pragma once
${H}ifndef ${guard}
${H}define ${guard}

#set($nsAction = "open")#parse("_namespaces.vm")

/// IDL const ${constNode.name} — generated by Entity Reactor IDL Generator.
${H}define ${constNode.name} ($types.type($constNode.type)) ${constNode.value}

#set($nsAction = "close")#parse("_namespaces.vm")

${H}endif // ${guard}
