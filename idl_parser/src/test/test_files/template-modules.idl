// This file contains a representative set of 'template module' declarations
// to test a parser against the FACE_IDL.g4 grammar.

// ========================================================================
// Example 1: Basic Template Module with a Single Typename Parameter
//
// Tests:
// - The fundamental `template module` syntax.
// - A single `typename` formal parameter.
// - A `tpl_definition` that uses the template parameter in a struct.
// ========================================================================
module DataWrapper<typename T> {
    struct Wrapper {
        T value;
        long long timestamp;
    };
};


// ========================================================================
// Example 2: Template Module with Multiple, Varied Formal Parameters
//
// Tests:
// - Multiple `formal_parameter` entries.
// - A variety of `formal_parameter_type`s:
//   - `typename` for a generic data type.
//   - `interface` for a generic interface type.
//   - `const` for a constant value.
//   - `sequence` for a generic sequence type.
// ========================================================================
module PubSub<
    typename MessageType,
    interface CallbackInterface,
    const long MAX_INSTANCES,
    sequence<octet> OpaqueSequence
>
{
    // A constant that uses a template parameter
    const long MAX_BUFFER_SIZE = MAX_INSTANCES * 1024;

    // A struct that uses multiple template parameters
    struct MessagePacket {
        MessageType payload;
        OpaqueSequence metadata;
    };

    // An interface that uses a template parameter
    interface DataListener {
        void on_data_received(in MessageType data);
    };

    // An interface that uses another template parameter
    interface Manager {
        void register_callback(in CallbackInterface cb);
    };
};


