// ========================================================================
// IDL Test File for Interface Declarations
//
// This file provides a comprehensive set of examples to test a parser's
// implementation of the `interface_or_forward_dcl` rule from FACE_IDL.g4.
// ========================================================================

module InterfaceTests {

    // ========================================================================
    // Part 1: Forward Declarations (`forward_dcl`)
    //
    // Tests the different forms of forward-declaring an interface without
    // providing its full definition yet.
    // ========================================================================

    // Test 1.1: A standard forward declaration.
    interface ForwardDeclaredInterface;

    // Test 1.2: An abstract forward declaration.
    abstract interface AbstractForwardDeclared;

    // Test 1.3: A local forward declaration.
    // 'local' interfaces cannot be accessed remotely.
    local interface LocalForwardDeclared;


    // ========================================================================
    // Part 2: Basic Interface Definitions (`interface_dcl`)
    //
    // Tests simple interface definitions with empty bodies.
    // ========================================================================

    // Test 2.1: A minimal, empty interface definition.
    interface SimpleInterface {
    };

    // Test 2.2: An abstract interface definition.
    // Abstract interfaces cannot be instantiated directly.
    abstract interface AbstractInterface {
    };

    // Test 2.3: A local interface definition.
    local interface LocalInterface {
    };


    // ========================================================================
    // Part 3: Interfaces with Inheritance (`interface_inheritance_spec`)
    //
    // Tests single and multiple inheritance syntax.
    // ========================================================================

    // Define some base interfaces for the tests below.
    interface BaseInterfaceOne {
        void doBaseOneAction();
    };
    interface BaseInterfaceTwo {
        void doBaseTwoAction();
    };

    // Test 3.1: An interface with single inheritance.
    interface SingleDerived : BaseInterfaceOne {
        void doDerivedAction();
    };

    // Test 3.2: An interface with multiple inheritance.
    interface MultipleDerived : BaseInterfaceOne, BaseInterfaceTwo {
        void doMultiDerivedAction();
    };

    // Test 3.3: An interface inheriting from a scoped name.
    // This requires the parser to correctly handle '::' in the inheritance spec.
    interface ScopedDerived : ::InterfaceTests::BaseInterfaceOne {
    };


    // ========================================================================
    // Part 4: A Complex Interface with a Full Body (`interface_body`)
    //
    // Tests an interface containing all possible `export_` types to ensure
    // the `interface_body` rule is parsed correctly.
    // ========================================================================

    interface ComplexInterface {
        // Test 4.1: Nested type declaration (`type_dcl` -> `struct_type`)
        struct Position {
            double x;
            double y;
            double z;
        };

        // Test 4.2: Nested constant declaration (`const_dcl`)
        const long MAX_RETRIES = 3;

        // Test 4.3: Nested exception declaration (`except_dcl`)
        exception OperationFailed {
            string reason;
            long error_code;
        };

        // Test 4.4: Read-only attribute (`attr_dcl` -> `readonly_attr_spec`)
        readonly attribute string uuid;

        // Test 4.5: Read-write attribute (`attr_dcl` -> `attr_spec`)
        attribute Position current_position;

        // Test 4.6: A oneway operation (`op_dcl` with `op_attribute`)
        oneway void reset_system();

        // Test 4.7: An operation with various parameter types (`op_dcl`)
        // Also tests using a forward-declared interface as a parameter.
//        long process_data(
//            sequence<octet> input_data,
//            string result_log,
//            ForwardDeclaredInterface callback
//        );

        // Test 4.8: An operation that returns void and raises an exception (`raises_expr`)
        void perform_action() raises (OperationFailed);
    };


    // ========================================================================
    // Part 5: Full Definition of a Previously Forward-Declared Interface
    //
    // This ensures the parser can handle definitions that appear after
    // their forward declaration.
    // ========================================================================

    // Test 5.1: Providing the full definition for `ForwardDeclaredInterface`.
    interface ForwardDeclaredInterface {
        attribute boolean is_active;
        void notify(in string message);
    };

};